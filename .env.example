# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=your-domain.com,localhost

# Database (Railway will provide this)
DATABASE_URL=postgresql://user:password@localhost:5432/christlike_db

# CORS
CORS_ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app,http://localhost:3000,http://localhost:5173

# Frontend URL
FRONTEND_URL=https://your-vercel-domain.vercel.app

# Gmail SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=yourgmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=yourgmail@gmail.com
CONTACT_RECEIVER_EMAIL=yourgmail@gmail.com
