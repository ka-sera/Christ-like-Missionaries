# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=your-backend-domain.com,localhost

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/christlike_db

# CORS
CORS_ALLOWED_ORIGINS=https://christ-likemissionaries.org,https://www.christ-likemissionaries.org,http://localhost:5173

# Frontend URL
FRONTEND_URL=https://christ-likemissionaries.org

# SMTP Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=your-smtp-host
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=your-email@your-domain.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=your-email@your-domain.com
CONTACT_RECEIVER_EMAIL=info@your-domain.com

# Prayer Requests
PRAYER_RECEIVER_EMAIL=prayerroom@your-domain.com

# Registration Notifications
REGISTRATION_RECEIVER_EMAIL=register@your-domain.com
